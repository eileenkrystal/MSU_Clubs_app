<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Page Title -->
        <TextView
            android:id="@+id/profileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Profile"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#18453B"
            android:layout_marginBottom="4dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/profileSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update your info so clubs can get to know you."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp" />

        <!-- Read-only email label -->
        <TextView
            android:id="@+id/profileEmailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MSU Email"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp" />

        <!-- Email (read-only) -->
        <EditText
            android:id="@+id/profileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:enabled="false"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:textColor="#555555"
            android:textColorHint="#999999"
            android:layout_marginBottom="20dp" />

        <!-- Name label -->
        <TextView
            android:id="@+id/profileNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp" />

        <!-- Name -->
        <EditText
            android:id="@+id/profileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:layout_marginBottom="16dp" />

        <!-- Major label -->
        <TextView
            android:id="@+id/profileMajorLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Major"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp" />

        <!-- Major -->
        <EditText
            android:id="@+id/profileMajor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Major (e.g., Computer Science)"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:layout_marginBottom="16dp" />

        <!-- Year label -->
        <TextView
            android:id="@+id/profileYearLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Year"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp" />

        <!-- Year -->
        <EditText
            android:id="@+id/profileYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Year (e.g., Sophomore)"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:layout_marginBottom="24dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#18453B"
            android:layout_marginBottom="12dp" />

        <!-- Delete Button -->
        <Button
            android:id="@+id/btnDeleteProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Profile"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:backgroundTint="#EEEEEE"
            android:textColor="#B00020"
            android:layout_marginBottom="8dp" />

        <!-- ⭐ Favorites section title -->
        <TextView
            android:id="@+id/favoritesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Favorite Clubs"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#18453B"
            android:layout_marginBottom="8dp" />

        <!-- Optional subtitle -->
        <TextView
            android:id="@+id/favoritesSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick access to clubs you've starred."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <!-- RecyclerView for favorites -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="ifContentScrolls" />

    </LinearLayout>

</ScrollView>
